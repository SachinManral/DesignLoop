GROQ_API_KEY=

# Google Gemini API key — used for deep 8-dimension rubric evaluations
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Server port (optional — defaults to 3001 locally, Render sets this automatically)
# PORT=3001
